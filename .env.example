# URL COMPLETA del endpoint de punteos de ERPAPI (misma convención que usa
# InterfazPunteo). NO es solo la raíz del dominio, incluye la ruta /api/appPunteo.
# Ejemplo: https://api.miempresa.com/api/appPunteo
VITE_API_BASE_URL=

# Opcional: sobreescribe el endpoint de login si no es
# {origen de VITE_API_BASE_URL}/api/auth/login-pos
VITE_AUTH_API_URL=

# Opcionales: deben coincidir exactamente con la llave/IV AES que usa ERPAPI
# (ERPAPI/Utils/EncriptacionService.cs) para desencriptar la contraseña del login.
# Si se omiten, se usan los valores por defecto del backend.
VITE_LOGIN_POS_AES_KEY=
VITE_LOGIN_POS_AES_IV=
